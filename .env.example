# Copy to .env for local runs. Real values live in Railway env vars.
# Never commit the real .env.

# SFTP account on TigerTech. The account is not chrooted, it has visibility
# into the real filesystem, so SFTP_BASE_PATH is the absolute path to the
# watch folder (confirmed via FileZilla). REQUIRED, no default in code:
# for the POC use /var/www/html/ju/julianfox.com/dojopoc/socialClips
SFTP_HOST=
SFTP_USER=
SFTP_PASS=
SFTP_PORT=22
SFTP_BASE_PATH=/var/www/html/ju/julianfox.com/dojopoc/socialClips
# Set true for one run to email a directory listing instead of processing
# clips, if SFTP_BASE_PATH turns out wrong (symptom: FileNotFoundError on
# list_pending_pairs). SFTP_DEBUG_LIST_PATH sets the listing's starting
# point (default "." = the SFTP login's default directory; try "/" for
# the true filesystem root). Turn SFTP_DEBUG_LIST_TREE back off after.
SFTP_DEBUG_LIST_TREE=false
SFTP_DEBUG_LIST_PATH=.

# Resend notifications
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional: verified sender address (defaults to onboarding@resend.dev,
# which only delivers to your own Resend account email)
NOTIFY_FROM=

# Caption generation (required)
ANTHROPIC_API_KEY=
# Optional overrides
CAPTION_MODEL=claude-opus-4-8
BRAND_VOICE_FILE=brand_voice.txt

# Publishing. Set false to run validation + captions + email preview only.
PUBLISH_ENABLED=true

# Rolling posting schedule: at most one clip posts per this many hours
# (24 = one per day, 12 = two per day, 0 = post everything immediately).
# Extra uploads queue in pending/ and post oldest first. Quiet runs where
# clips are just waiting (or pending/ is empty) send no email.
POST_INTERVAL_HOURS=24

# YouTube. YT_REFRESH_TOKEN comes from scripts/get_youtube_refresh_token.py.
# YT_CLIENT_ID and YT_CLIENT_SECRET are the two separate values shown on
# Google Cloud Console under Credentials > OAuth 2.0 Client IDs > your
# Desktop client. Copy them exactly as shown there, each into its own var;
# do NOT paste just the "Client secret" value into YT_CLIENT_SECRET_JSON,
# that variable wants the full downloaded client_secret.json content (or a
# path to that file) and is only kept as an alternative to the two-var form.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_CLIENT_SECRET_JSON=
YT_REFRESH_TOKEN=
# Keep private until final testing, then flip to public
YT_PRIVACY_STATUS=private
YT_CATEGORY_ID=17

# Instagram (IG_ACCESS_TOKEN is the bootstrap; the live token is persisted
# on the SFTP host at SFTP_BASE_PATH/ig_token.json and refreshed weekly)
IG_ACCESS_TOKEN=
IG_USER_ID=17841412338243421
# Held for a future manual OAuth redo; not used by the pipeline directly.
# Regenerate IG_APP_SECRET in the Meta dashboard before production, it was
# exposed once during setup.
IG_APP_ID=
IG_APP_SECRET=

# Public HTTPS base for clips in pending/ (Instagram fetches from here).
# REQUIRED, no default in code: for the POC use the value below.
PUBLIC_CLIP_BASE_URL=https://dojopoc.julianfox.com/socialClips/pending
