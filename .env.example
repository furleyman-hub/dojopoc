# Copy to .env for local runs. Real values live in Railway env vars.
# Never commit the real .env.

# SFTP account jailed to socialClips/ on TigerTech
SFTP_HOST=
SFTP_USER=
SFTP_PASS=
SFTP_PORT=22

# Resend notifications
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional: verified sender address (defaults to onboarding@resend.dev,
# which only delivers to your own Resend account email)
NOTIFY_FROM=

# Needed from build order step 4 onward (not used by the skeleton yet)
ANTHROPIC_API_KEY=

# Needed from step 5 onward (YT_REFRESH_TOKEN comes from
# scripts/get_youtube_refresh_token.py)
YT_CLIENT_SECRET_JSON=
YT_REFRESH_TOKEN=

# Needed from step 6 onward
IG_ACCESS_TOKEN=
IG_USER_ID=17841412338243421
IG_APP_ID=
IG_APP_SECRET=
